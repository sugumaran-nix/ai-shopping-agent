# Provider credentials are optional when users enter session-only keys in the frontend.
SCRAPERAPI_KEY=
SCRAPINGANT_API_KEY=
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=web_unlocker1

# Production security
ALLOWED_ORIGINS=https://your-frontend.vercel.app
OPS_TOKEN=generate-a-long-random-operations-token

# Runtime and resilience
ENVIRONMENT=development
LOG_LEVEL=INFO
CACHE_DIR=.cache
REDIS_URL=
CACHE_TTL_SECONDS=1800
STALE_SERVE_TTL_SECONDS=21600
CACHE_MAX_SIZE_BYTES=500000000
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=1
CONCURRENT_SCRAPE_LIMIT=4
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60
